# Godot 本地缓存（不入库）
.godot/
# 导出产物
export/
*.exe
*.pck
# .NET 构建产物（不入库）
bin/
obj/

# 桌面截图（含本机桌面内容，不入库）
logs/**/desktop-*.png

# ===== 2026-10-30 开源公开前补充 =====
# 运行日志与探针输出：无源码价值，只记录本机运行状态
logs/
# 调试 / 对比 / 诊断截图：下划线前缀为临时产物，不进公开仓库
shots/_*
# 截图默认不入库，仅保留商店素材（对外展示用）
shots/*
!shots/store/
!shots/store/**
# AI 工具会话状态目录（本机状态，非工程内容）
.mimosa/
# 安卓与桌面包体（体积大、可由源码重建）
*.apk
*.aab
*.zip
# 系统垃圾文件
.DS_Store
Thumbs.db
desktop.ini
